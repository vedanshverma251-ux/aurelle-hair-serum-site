# Copy to .env and fill in. NEVER commit .env
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurelle?schema=public"

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_64_random_hex_chars_replace_me_with_64_random_hex
COOKIE_SECRET=replace_me_with_64_random_hex_chars_replace_me_with_64_random_hex

# Optional: Stripe (INR supported). Without these, orders are created as PENDING (pay on delivery).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: seeds an admin account when running `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
