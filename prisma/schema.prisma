generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           Role           @default(USER)
  failedLogins   Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]
  orders         Order[]
  reviews        Review[]
  wishlist       WishlistItem[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Product {
  id          String              @id @default(uuid())
  slug        String              @unique
  name        String
  tagline     String
  description String
  priceMinor  Int
  currency    String              @default("INR")
  sizeMl      Int
  type        String
  accent      String
  stock       Int                 @default(0)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  ingredients ProductIngredient[]
  reviews     Review[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]

  @@index([active])
}

model Ingredient {
  id       String              @id @default(uuid())
  name     String              @unique
  benefit  String
  icon     String
  products ProductIngredient[]
}

model ProductIngredient {
  productId    String
  ingredientId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  title      String
  body       String
  authorName String
  productId  String
  userId     String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model Order {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email        String
  status       OrderStatus @default(PENDING)
  totalMinor   Int
  currency     String      @default("INR")
  shipName     String
  shipPhone    String
  shipLine1    String
  shipCity     String
  shipPincode  String
  paymentRef   String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  items        OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitMinor Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Store {
  id      String @id @default(uuid())
  name    String
  city    String
  address String
  pincode String

  @@index([pincode])
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}
